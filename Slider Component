export default function SpeedSlider({ speed, setSpeed }) {
  return (
    <div style={{ marginBottom: 20 }}>
      <h3>Vehicle Speed: {speed} km/h</h3>

      <input
        type="range"
        min="0"
        max="200"
        value={speed}
        onChange={(e) => setSpeed(Number(e.target.value))}
        style={{ width: "100%" }}
      />
    </div>
  );
}
