export default function SpeedSlider({ speed, setSpeed }) {
  return (
    <div className="card">
      <h3>Vehicle Speed Control</h3>
      <p>Adjust speed to see system behavior in real-time</p>

      <input
        type="range"
        min="0"
        max="200"
        value={speed}
        onChange={(e) => setSpeed(Number(e.target.value))}
        style={{ width: "100%" }}
      />

      <p>
        Current Speed: <span className="highlight">{speed} km/h</span>
      </p>
    </div>
  );
}
