body {
  margin: 0;
  font-family: Inter, system-ui, Arial;
  background: #0b1220;
  color: #e5e7eb;
}

h1 {
  font-size: 22px;
  margin-bottom: 4px;
}

p {
  color: #94a3b8;
}

.card {
  background: #111827;
  border: 1px solid #1f2937;
  border-radius: 12px;
  padding: 16px;
  margin-top: 16px;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.highlight {
  color: #60a5fa;
  font-weight: bold;
}
