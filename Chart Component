import {
  LineChart,
  Line,
  XAxis,
  YAxis,
  Tooltip,
  CartesianGrid,
} from "recharts";

export default function SpeedChart({ data }) {
  return (
    <div>
      <h3>Speed Over Time</h3>

      <LineChart width={700} height={300} data={data}>
        <CartesianGrid stroke="#ccc" />
        <XAxis dataKey="time" />
        <YAxis />
        <Tooltip />
        <Line type="monotone" dataKey="speed" stroke="#3b82f6" />
        <Line type="monotone" dataKey="temp" stroke="#ef4444" />
      </LineChart>
    </div>
  );
}
